PORT=8080
HOST=127.0.0.1
LOG_FILE=/root/llm-gw/usage.jsonl

# upstreams and model routing live in upstreams.json (see upstreams.example.json).
# UPSTREAM_BASE / UPSTREAM_KEYS are only used when that file is missing.
ROUTES_FILE=/root/llm-gw/upstreams.json
UPSTREAM_BASE=https://free.ai.id/v1
UPSTREAM_KEYS=sk-upstream-1,sk-upstream-2

# client keys live in keys.json; CLIENT_KEYS only seeds it on first run
KEYS_FILE=/root/llm-gw/keys.json
CLIENT_KEYS=owner:sk-gw-owner,friend:sk-gw-friend

# admin listener (loopback only, never exposed through the tunnel)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081
ADMIN_KEY=change-me-to-32-bytes-of-hex

# failover behaviour
BREAKER_MS=300000
TOTAL_BUDGET_MS=90000
